# ZentroMart AI Customer Support - Environment Configuration Template

# Backend Settings
APP_ENV=development
DEBUG=true
DATASET_DIR=Capstone_Project_Dataset_FTTT_2026
FRONTEND_ORIGIN=http://localhost:3000

# Upstream LLM Configuration (Optional - platform operates via deterministic fallback if omitted)
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_MODEL=

# Gnani AI Speech Integration (Optional - voice recorder shows configuration status if omitted)
# Official Docs: https://docs.gnani.ai/api/introduction/introduction
GNANI_API_KEY=
GNANI_TOKEN=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# TinyFish Autonomous Web Agent (Optional - cloud browser agent for web research/automation)
# Official Docs: https://agent.tinyfish.ai
TINYFISH_API_KEY=
TINYFISH_API_URL=https://agent.tinyfish.ai/v1/agent/run
TINYFISH_TIMEOUT=60.0
